!!==============================================================================
!> @brief Unit tests for some SAM subroutines.
!>
!> @author Knut Morten Okstad
!>
!> @date 18 Aug 2026

@test
subroutine testDMVV
#if FT_PFUNIT > 3
  use funit, only : assertEqual, sourceLocation, anyExceptions
#else
  use pfunit_mod, only : assertEqual, sourceLocation, anyExceptions
#endif

  implicit none

  integer, parameter :: n = 20
  integer :: i
  double precision a(n), b(n), c(n), d

  print *,'DMVV test'
  A = (/ (i*0.1D0,i=1,n) /)
  B = (/ (i*1.0D0,i=1,n) /)
  call DMVV (n,a,1,b,1,c)
  print "(10F5.1)",c
  do i = 1, n
     d = 0.1D0*i*i
     @assertEqual(c(i),d)
  end do

end subroutine testDMVV


@test
subroutine testIOTA
#if FT_PFUNIT > 3
  use funit, only : assertEqual, sourceLocation, anyExceptions
#else
  use pfunit_mod, only : assertEqual, sourceLocation, anyExceptions
#endif

  implicit none

  integer, parameter :: n = 20
  integer :: i, iarr(n), jarr(3,n)

  print *,'IOTA test'
  call IOTA (n,iarr(1),1,10)
  print "(10I3)",iarr
  do i = 1, n
     @assertEqual(iarr(i),9+i)
  end do

  call IOTA (n,iarr(1),-1,10)
  print "(10I3)",iarr
  do i = 1, n
     @assertEqual(iarr(i),n+10-i)
  end do

  call IOTA (n,jarr(1,1),3,0)
  call IOTA (n,jarr(2,1),3,10)
  call IOTA (n,jarr(3,1),3,20)
  print "(10I3)",(jarr(i,:),i=1,3)
  do i = 1, n
     @assertEqual(jarr(1,i),i-1)
     @assertEqual(jarr(2,i),9+i)
     @assertEqual(jarr(3,i),19+i)
  end do

end subroutine testIOTA
